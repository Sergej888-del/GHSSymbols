---
interface SubRow {
  cas_number: string
  common_name: string | null
  iupac_name: string
}

interface Props {
  hCode: string
  substances: SubRow[]
  total: number
  page: number
  pageSize: number
}

const { hCode, substances, total, page, pageSize } = Astro.props
const totalPages = total === 0 ? 0 : Math.ceil(total / pageSize)
const displayName = (s: SubRow) => s.common_name || s.iupac_name
---

<section class="mt-12">
  <h2 class="text-xl font-bold text-gray-900 mb-4">Substances with {hCode}</h2>
  {substances.length === 0 ? (
    <p class="text-gray-600">No substances in our database currently carry this statement.</p>
  ) : (
    <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
      <table class="min-w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-100 text-left">
            <th class="px-4 py-3 font-semibold border-b border-gray-200">CAS Number</th>
            <th class="px-4 py-3 font-semibold border-b border-gray-200">Name</th>
          </tr>
        </thead>
        <tbody>
          {substances.map((s) => (
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="px-4 py-3 font-mono text-blue-700 font-semibold whitespace-nowrap">
                <a href={`/hazards/${encodeURIComponent(s.cas_number)}/`} class="hover:underline">
                  {s.cas_number}
                </a>
              </td>
              <td class="px-4 py-3 text-gray-800">
                <a
                  href={`/hazards/${encodeURIComponent(s.cas_number)}/`}
                  class="hover:text-[#062A78] hover:underline"
                >
                  {displayName(s)}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  {total > 0 && (
    <p class="mt-3 text-sm text-gray-600">
      Showing {(page - 1) * pageSize + 1}–{Math.min(page * pageSize, total)} of {total} substances
      (IUPAC name order).
    </p>
  )}
  {totalPages > 1 && (
    <nav class="mt-6 flex flex-wrap gap-2 items-center text-sm" aria-label="Pagination">
      {page > 1 && (
        <a
          href={page === 2 ? `/h-statements/${encodeURIComponent(hCode)}/` : `/h-statements/${encodeURIComponent(hCode)}/page/${page - 1}/`}
          class="px-3 py-1.5 rounded border border-gray-300 text-[#062A78] font-medium hover:bg-gray-50"
        >
          ← Previous
        </a>
      )}
      <span class="text-gray-500 px-2">
        Page {page} of {totalPages}
      </span>
      {page < totalPages && (
        <a
          href={`/h-statements/${encodeURIComponent(hCode)}/page/${page + 1}/`}
          class="px-3 py-1.5 rounded border border-gray-300 text-[#062A78] font-medium hover:bg-gray-50"
        >
          Next →
        </a>
      )}
    </nav>
  )}
</section>

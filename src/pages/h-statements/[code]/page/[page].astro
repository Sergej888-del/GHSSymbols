---
import Layout from '../../../../layouts/Layout.astro'
import { truncateMetaDescription } from '../../../../lib/metaDescription'
import { supabase } from '../../../../lib/supabase'
import HStatementSubstanceList from '../../../../components/HStatementSubstanceList.astro'
import {
  countSubstancesPerHCode,
  H_SUBSTANCES_PAGE_SIZE,
} from '../../../../lib/hStatementPagination'

const siteUrl = 'https://ghssymbols.com'

export async function getStaticPaths() {
  const counts = await countSubstancesPerHCode(supabase)
  const { data: codes } = await supabase.from('h_statements').select('code')
  const paths: { params: { code: string; page: string } }[] = []
  for (const r of codes ?? []) {
    const code = r.code
    const n = counts.get(code) ?? 0
    const pages = Math.ceil(n / H_SUBSTANCES_PAGE_SIZE)
    for (let p = 2; p <= pages; p++) {
      paths.push({ params: { code, page: String(p) } })
    }
  }
  return paths
}

const rawCode = Astro.params.code ?? ''
const code = decodeURIComponent(rawCode)
const pageNum = Math.max(2, parseInt(Astro.params.page ?? '2', 10) || 2)

const { data: row } = await supabase
  .from('h_statements')
  .select('code, category, text_en, ghs_revision')
  .eq('code', code)
  .maybeSingle()

if (!row) {
  return Astro.redirect('/h-statements/')
}

const h = row as {
  code: string
  category: string
  text_en: string
  ghs_revision: number | null
}

const { count } = await supabase
  .from('substances')
  .select('*', { count: 'exact', head: true })
  .contains('h_statement_codes', [code])
  .not('cas_number', 'is', null)

const total = count ?? 0
const totalPages = total === 0 ? 0 : Math.ceil(total / H_SUBSTANCES_PAGE_SIZE)

if (pageNum < 2 || totalPages < 2 || pageNum > totalPages) {
  return Astro.redirect(`/h-statements/${encodeURIComponent(code)}/`)
}

const from = (pageNum - 1) * H_SUBSTANCES_PAGE_SIZE
const to = from + H_SUBSTANCES_PAGE_SIZE - 1

const { data: subs } = await supabase
  .from('substances')
  .select('cas_number, common_name, iupac_name')
  .contains('h_statement_codes', [code])
  .not('cas_number', 'is', null)
  .order('iupac_name', { ascending: true })
  .range(from, to)

const substances = (subs ?? []) as {
  cas_number: string
  common_name: string | null
  iupac_name: string
}[]

const { data: allCodeRows } = await supabase
  .from('h_statements')
  .select('code')
  .order('code', { ascending: true })
const orderedCodes = (allCodeRows ?? []).map((r) => r.code)
const idx = orderedCodes.indexOf(code)
const prevCode = idx > 0 ? orderedCodes[idx - 1] : null
const nextCode = idx >= 0 && idx < orderedCodes.length - 1 ? orderedCodes[idx + 1] : null

const title = `${h.code} (page ${pageNum}) — Substances | GHS Symbols`
const description = truncateMetaDescription(
  `${h.code}: ${h.text_en} Substances page ${pageNum} of ${totalPages}.`
)
const canonical = `${siteUrl}/h-statements/${encodeURIComponent(h.code)}/page/${pageNum}/`
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="text-[#062A78] hover:underline">Home</a>
      <span class="mx-2">→</span>
      <a href="/h-statements/" class="text-[#062A78] hover:underline">H-Statements</a>
      <span class="mx-2">→</span>
      <a href={`/h-statements/${encodeURIComponent(h.code)}/`} class="text-[#062A78] hover:underline">
        {h.code}
      </a>
      <span class="mx-2">→</span>
      <span class="text-gray-700">Page {pageNum}</span>
    </nav>

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug">
      <span class="text-blue-700 font-mono">{h.code}</span>
      <span class="text-gray-400 font-normal mx-2">—</span>
      <span>{h.text_en}</span>
    </h1>

    <p class="mt-4 text-sm text-gray-600">
      <a href={`/h-statements/${encodeURIComponent(h.code)}/`} class="text-[#062A78] font-semibold hover:underline">
        ← Back to statement overview
      </a>
    </p>

    <HStatementSubstanceList
      hCode={h.code}
      substances={substances}
      total={total}
      page={pageNum}
      pageSize={H_SUBSTANCES_PAGE_SIZE}
    />

    <nav class="mt-10 flex flex-wrap justify-between gap-4 text-sm border-t border-gray-200 pt-8">
      {prevCode ? (
        <a
          href={`/h-statements/${encodeURIComponent(prevCode)}/`}
          class="text-[#062A78] font-semibold hover:underline"
        >
          ← Previous {prevCode}
        </a>
      ) : (
        <span class="text-gray-400">← Previous</span>
      )}
      {nextCode ? (
        <a
          href={`/h-statements/${encodeURIComponent(nextCode)}/`}
          class="text-[#062A78] font-semibold hover:underline"
        >
          Next {nextCode} →
        </a>
      ) : (
        <span class="text-gray-400">Next →</span>
      )}
    </nav>

    <p class="mt-10 text-center">
      <a href="/hazards/" class="text-[#062A78] font-semibold hover:underline inline-flex items-center gap-1">
        Explore related substances in our GHS Hazard Database →
      </a>
    </p>
  </div>
</Layout>

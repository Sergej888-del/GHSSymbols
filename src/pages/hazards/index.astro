---
// Алфавитный указатель + клиентский поиск
import Layout from '../../layouts/Layout.astro'
import HazardsDatabase from '../../components/HazardsDatabase'
import { supabase } from '../../lib/supabase'

type Row = {
  cas_number: string
  common_name: string | null
  iupac_name: string
}

let allRows: Row[] = []
let from = 0
const pageSize = 1000
while (true) {
  const { data } = await supabase
    .from('substances')
    .select('cas_number, common_name, iupac_name')
    .not('cas_number', 'is', null)
    .order('iupac_name', { ascending: true })
    .range(from, from + pageSize - 1)

  if (!data?.length) break
  allRows = [...allRows, ...(data as Row[])]
  if (data.length < pageSize) break
  from += pageSize
}

function displayName(s: Row): string {
  return (s.common_name || s.iupac_name || '').trim()
}

function firstLetter(name: string): string {
  const c = name.charAt(0).toUpperCase()
  if (c >= 'A' && c <= 'Z') return c
  return '#'
}

const grouped: Record<string, Row[]> = {}
for (const s of allRows) {
  const label = displayName(s)
  const letter = firstLetter(label)
  if (!grouped[letter]) grouped[letter] = []
  grouped[letter].push(s)
}

const letters = Object.keys(grouped).sort((a, b) => {
  if (a === '#') return 1
  if (b === '#') return -1
  return a.localeCompare(b)
})
---

<Layout
  title="Chemical Hazards Database"
  description="Browse GHS hazard classifications, H-statements, and pictograms for 5000+ chemicals from ECHA CLP Annex VI."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Chemical Hazards Database</h1>
    <p class="text-gray-600 mb-6">
      {allRows.length.toLocaleString('en-US')} substances with harmonized GHS/CLP classifications from ECHA. Jump by
      letter or use search below.
    </p>

    <nav
      class="flex flex-wrap gap-2 mb-10 pb-6 border-b border-gray-200"
      aria-label="Alphabetical index"
    >
      {letters.map((L) => (
        <a
          href={`#letter-${L === '#' ? 'sym' : L}`}
          class="inline-flex min-w-[2rem] justify-center px-2 py-1 text-sm font-semibold rounded bg-blue-50 text-[#062A78] hover:bg-blue-100 border border-blue-200"
        >
          {L}
        </a>
      ))}
    </nav>

    <div class="space-y-10 mb-16">
      {letters.map((L) => (
        <section id={L === '#' ? 'letter-sym' : `letter-${L}`} class="scroll-mt-24">
          <h2 class="text-xl font-bold text-gray-900 mb-3 border-l-4 border-[#062A78] pl-3">{L}</h2>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
            {grouped[L].map((s) => (
              <li class="truncate">
                <a
                  href={`/hazards/${encodeURIComponent(s.cas_number)}/`}
                  class="text-[#062A78] hover:underline font-medium"
                >
                  {displayName(s)}
                </a>
                <span class="text-gray-400 font-mono text-xs ml-2">CAS {s.cas_number}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <h2 class="text-xl font-bold text-gray-900 mb-4">Search &amp; filters</h2>
    <p class="text-gray-600 mb-4 text-sm">
      Filter by hazard class, pictograms, signal word, or free text (client-side).
    </p>
    <HazardsDatabase client:load />
  </div>
</Layout>
